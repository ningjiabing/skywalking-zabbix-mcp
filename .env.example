# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# ---- SkyWalking (required) ----
# OAP address; "/graphql" is appended automatically if missing.
SW_URL=http://oap-host:12800
# Basic Auth, leave empty if the OAP has no auth.
SW_USERNAME=
SW_PASSWORD=
# Skip TLS verification (testing only).
SW_INSECURE=false
# debug | info | warn | error
SW_LOG_LEVEL=info

# ---- Zabbix (optional) ----
# Setting ZABBIX_URL enables the 2 Zabbix tools + the 2 correlation tools.
# Full path to api_jsonrpc.php. Sub-path install: http://host/zabbix/api_jsonrpc.php
# Root install: http://host:port/api_jsonrpc.php
ZABBIX_URL=
ZABBIX_USER=
ZABBIX_PASSWORD=
# Read-only guard: rejects every Zabbix method that is not *.get
READ_ONLY=true
# Verify Zabbix TLS certificates.
VERIFY_SSL=true
# Compatibility placeholder (no-op in this client).
ZABBIX_SKIP_VERSION_CHECK=false
